{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vestagraph.invalid/schema/forbidden-words.schema.json",
  "title": "AI-03 forbidden-word list (evaluation/forbidden-words.json)",
  "description": "The versioned list of verdict, score, ranking and approval words the chat's answers must never contain (AGENTS rule 4, decision 0004, WCHAT-67 to 80). A word matches whole words only, case-insensitively, so 'Safestore' and 'safety' do not match 'safe'. The list is not applied inside the places named in allowIn.",
  "type": "object",
  "required": [
    "version",
    "sources",
    "words",
    "allowIn"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "words": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z]+( [a-z]+)*$"
      }
    },
    "allowIn": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "user-turn",
          "quoted-source"
        ]
      }
    }
  }
}
