{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vestagraph.invalid/schema/generated-energy-certificate-result.schema.json",
  "title": "Energy certificate result (generated/energy-certificate-result.json)",
  "description": "What the energy certificate page quotes (DA-09): per sample certificate number, an outcome, the validity dates calculated by vestagraph_area (rule 2) and every fact in words. A fact the certificate lacks, or a code the tables lack, is the missing object, never zero, blank or a raw code (rule 7). Money is whole pence. No address, postcode or post town exists in this shape.",
  "type": "object",
  "required": ["$schema", "formatVersion", "today", "certificates"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "formatVersion": { "const": 1 },
    "today": { "$ref": "common.schema.json#/$defs/fullDate" },
    "certificates": { "type": "array", "items": { "$ref": "#/$defs/certificate" } }
  },
  "$defs": {
    "number": { "type": "string", "pattern": "^0000-0000-\\d{4}-\\d{4}-\\d{4}$" },
    "missing": {
      "type": "object",
      "required": ["status", "text"],
      "additionalProperties": false,
      "properties": {
        "status": { "const": "missing" },
        "text": { "const": "Not on this certificate" }
      }
    },
    "words": { "oneOf": [{ "type": "string", "minLength": 1 }, { "$ref": "#/$defs/missing" }] },
    "pence": { "type": "integer", "minimum": 0 },
    "rating": {
      "oneOf": [
        { "$ref": "#/$defs/missing" },
        {
          "type": "object",
          "required": ["band", "score"],
          "additionalProperties": false,
          "properties": {
            "band": { "enum": ["A", "B", "C", "D", "E", "F", "G"] },
            "score": { "type": "integer", "minimum": 1 }
          }
        }
      ]
    },
    "costPair": {
      "type": "object",
      "required": ["currentPence", "potentialPence"],
      "additionalProperties": false,
      "properties": {
        "currentPence": { "$ref": "#/$defs/pence" },
        "potentialPence": { "$ref": "#/$defs/pence" }
      }
    },
    "certificate": {
      "oneOf": [
        {
          "type": "object",
          "required": ["number", "outcome"],
          "additionalProperties": false,
          "properties": {
            "number": { "$ref": "#/$defs/number" },
            "outcome": { "enum": ["not-domestic", "not-yet-covered"] }
          }
        },
        {
          "type": "object",
          "required": [
            "number", "outcome", "validUntil", "moreThanTenYearsOld", "currentRating",
            "potentialRating", "propertyType", "builtForm", "totalFloorAreaSquareMetres",
            "costs", "parts", "improvements"
          ],
          "additionalProperties": false,
          "properties": {
            "number": { "$ref": "#/$defs/number" },
            "outcome": { "const": "shown" },
            "validUntil": { "$ref": "common.schema.json#/$defs/fullDate" },
            "moreThanTenYearsOld": { "type": "boolean" },
            "statusLine": {
              "type": "object",
              "required": ["status", "text"],
              "additionalProperties": false,
              "properties": {
                "status": { "enum": ["superseded", "cancelled"] },
                "text": { "type": "string", "minLength": 1 }
              }
            },
            "currentRating": { "$ref": "#/$defs/rating" },
            "potentialRating": { "$ref": "#/$defs/rating" },
            "propertyType": { "$ref": "#/$defs/words" },
            "builtForm": { "$ref": "#/$defs/words" },
            "totalFloorAreaSquareMetres": {
              "oneOf": [
                { "$ref": "#/$defs/missing" },
                { "type": "integer", "minimum": 1 },
                { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" }
              ]
            },
            "costs": {
              "oneOf": [
                { "$ref": "#/$defs/missing" },
                {
                  "type": "object",
                  "required": ["heating", "hotWater", "lighting"],
                  "additionalProperties": false,
                  "properties": {
                    "heating": { "$ref": "#/$defs/costPair" },
                    "hotWater": { "$ref": "#/$defs/costPair" },
                    "lighting": { "$ref": "#/$defs/costPair" }
                  }
                }
              ]
            },
            "parts": {
              "oneOf": [
                { "$ref": "#/$defs/missing" },
                {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["part", "description", "stars"],
                    "additionalProperties": false,
                    "properties": {
                      "part": { "type": "string", "minLength": 1 },
                      "description": { "type": "string", "minLength": 1 },
                      "stars": { "type": "integer", "minimum": 1, "maximum": 5 }
                    }
                  }
                }
              ]
            },
            "improvements": {
              "oneOf": [
                { "$ref": "#/$defs/missing" },
                {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["sequence", "description", "indicativeCost", "typicalSavingPence"],
                    "additionalProperties": false,
                    "properties": {
                      "sequence": { "type": "integer", "minimum": 1 },
                      "description": { "$ref": "#/$defs/words" },
                      "indicativeCost": { "type": "string", "minLength": 1 },
                      "typicalSavingPence": { "$ref": "#/$defs/pence" }
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    }
  }
}
