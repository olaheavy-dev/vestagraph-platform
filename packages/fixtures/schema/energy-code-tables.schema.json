{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vestagraph.invalid/schema/energy-code-tables.schema.json",
  "title": "Energy certificate code tables (reference/energy-code-tables.json)",
  "description": "Real official code-to-words tables for energy certificates (DA-09). Unlike everything in data/, these are published data, each table with its source URL and effective date (AGENTS.md rule 3). While 'partial' is true the file holds only the codes the sample certificates use.",
  "type": "object",
  "required": [
    "partial",
    "tables",
    "sources"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "partial": {
      "type": "boolean"
    },
    "tables": {
      "type": "object",
      "required": [
        "propertyType",
        "builtForm",
        "improvement"
      ],
      "additionalProperties": false,
      "properties": {
        "propertyType": {
          "$ref": "#/$defs/table"
        },
        "builtForm": {
          "$ref": "#/$defs/table"
        },
        "improvement": {
          "$ref": "#/$defs/table"
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "table": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^[0-9A-Z]+$": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "description": "Register code (as text) to the official words."
    },
    "source": {
      "type": "object",
      "required": [
        "table",
        "url",
        "effectiveDate",
        "checked"
      ],
      "additionalProperties": false,
      "properties": {
        "table": {
          "enum": [
            "propertyType",
            "builtForm",
            "improvement",
            "validity"
          ]
        },
        "url": {
          "type": "string",
          "pattern": "^https://\\S+$"
        },
        "effectiveDate": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/fullDate"
            },
            {
              "const": "as published"
            }
          ],
          "description": "The date the source states, or 'as published' when it states none (the checked date then says when it was read)."
        },
        "checked": {
          "$ref": "common.schema.json#/$defs/fullDate"
        }
      }
    }
  }
}
