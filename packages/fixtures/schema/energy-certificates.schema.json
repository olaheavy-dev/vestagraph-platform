{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vestagraph.invalid/schema/energy-certificates.schema.json",
  "title": "Sample energy certificates (data/energy-certificates.json)",
  "description": "Synthetic energy certificates in Vestagraph's own normalised shape: what the page receives after the adapter has dropped the address fields (DA-09, design 2026-11-18). No address, postcode, post town or address line exists in this shape, and additionalProperties is false so any such field is rejected. Money is whole pence (decision 0036). A fact the certificate does not hold is {\"status\": \"missing\"}, never zero or blank (AGENTS.md rule 7). Certificate numbers are obviously synthetic (0000-0000-0000-0000-...).",
  "type": "object",
  "required": [
    "nation",
    "certificates"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "nation": {
      "const": "england"
    },
    "certificates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/certificate"
      }
    }
  },
  "$defs": {
    "certificate": {
      "type": "object",
      "required": [
        "number",
        "schema",
        "country",
        "kind",
        "status",
        "registrationDate",
        "inspectionDate",
        "currentRating",
        "potentialRating",
        "propertyTypeCode",
        "builtFormCode",
        "totalFloorAreaSquareMetres",
        "costs",
        "parts",
        "improvements"
      ],
      "additionalProperties": false,
      "properties": {
        "number": {
          "type": "string",
          "pattern": "^0000-0000-0000-0000-\\d{4}$",
          "description": "Twenty digits in five groups, always starting 0000-0000-0000-0000-, so it is obviously synthetic."
        },
        "schema": {
          "type": "string",
          "pattern": "^(RdSAP|SAP|CEPC)-(Schema-)?[0-9.]+$",
          "description": "The register's schema name, for example RdSAP-Schema-21.0.1."
        },
        "country": {
          "enum": [
            "england",
            "wales"
          ],
          "description": "The register covers England and Wales."
        },
        "kind": {
          "enum": [
            "domestic",
            "non-domestic"
          ]
        },
        "status": {
          "enum": [
            "entered",
            "cancelled",
            "superseded"
          ],
          "description": "As the register marks the certificate."
        },
        "registrationDate": {
          "$ref": "common.schema.json#/$defs/fullDate"
        },
        "inspectionDate": {
          "$ref": "common.schema.json#/$defs/fullDate"
        },
        "currentRating": {
          "$ref": "#/$defs/ratingFact"
        },
        "potentialRating": {
          "$ref": "#/$defs/ratingFact"
        },
        "propertyTypeCode": {
          "$ref": "#/$defs/codeFact"
        },
        "builtFormCode": {
          "$ref": "#/$defs/codeFact"
        },
        "totalFloorAreaSquareMetres": {
          "$ref": "#/$defs/areaFact"
        },
        "costs": {
          "$ref": "#/$defs/costsFact"
        },
        "parts": {
          "$ref": "#/$defs/partsFact"
        },
        "improvements": {
          "$ref": "#/$defs/improvementsFact"
        }
      }
    },
    "missing": {
      "type": "object",
      "required": [
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "missing"
        }
      },
      "description": "The certificate does not hold this fact (rule 7): never zero, blank or a favourable value."
    },
    "money": {
      "type": "object",
      "required": [
        "pence",
        "period"
      ],
      "additionalProperties": false,
      "properties": {
        "pence": {
          "$ref": "common.schema.json#/$defs/pence"
        },
        "period": {
          "const": "year"
        }
      }
    },
    "ratingFact": {
      "oneOf": [
        {
          "$ref": "#/$defs/missing"
        },
        {
          "type": "object",
          "required": [
            "value",
            "source"
          ],
          "additionalProperties": false,
          "properties": {
            "value": {
              "$ref": "#/$defs/rating"
            },
            "source": {
              "$ref": "common.schema.json#/$defs/source"
            }
          }
        }
      ]
    },
    "rating": {
      "type": "object",
      "required": [
        "band",
        "score"
      ],
      "additionalProperties": false,
      "properties": {
        "band": {
          "enum": [
            "A",
            "B",
            "C",
            "D",
            "E",
            "F",
            "G"
          ]
        },
        "score": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "codeFact": {
      "oneOf": [
        {
          "$ref": "#/$defs/missing"
        },
        {
          "type": "object",
          "required": [
            "value",
            "source"
          ],
          "additionalProperties": false,
          "properties": {
            "value": {
              "type": "string",
              "pattern": "^[0-9A-Z]+$",
              "description": "The register's code, as text. Words come from reference/energy-code-tables.json."
            },
            "source": {
              "$ref": "common.schema.json#/$defs/source"
            }
          }
        }
      ]
    },
    "areaFact": {
      "oneOf": [
        {
          "$ref": "#/$defs/missing"
        },
        {
          "type": "object",
          "required": [
            "value",
            "source"
          ],
          "additionalProperties": false,
          "properties": {
            "value": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "source": {
              "$ref": "common.schema.json#/$defs/source"
            }
          }
        }
      ]
    },
    "costPair": {
      "type": "object",
      "required": [
        "current",
        "potential"
      ],
      "additionalProperties": false,
      "properties": {
        "current": {
          "$ref": "#/$defs/money"
        },
        "potential": {
          "$ref": "#/$defs/money"
        }
      }
    },
    "costsFact": {
      "oneOf": [
        {
          "$ref": "#/$defs/missing"
        },
        {
          "type": "object",
          "required": [
            "value",
            "source"
          ],
          "additionalProperties": false,
          "properties": {
            "value": {
              "type": "object",
              "required": [
                "heating",
                "hotWater",
                "lighting"
              ],
              "additionalProperties": false,
              "properties": {
                "heating": {
                  "$ref": "#/$defs/costPair"
                },
                "hotWater": {
                  "$ref": "#/$defs/costPair"
                },
                "lighting": {
                  "$ref": "#/$defs/costPair"
                }
              }
            },
            "source": {
              "$ref": "common.schema.json#/$defs/source"
            }
          }
        }
      ],
      "description": "The certificate's own yearly running-cost estimates, in whole pence. Estimates, not bills."
    },
    "part": {
      "type": "object",
      "required": [
        "part",
        "description",
        "stars"
      ],
      "additionalProperties": false,
      "properties": {
        "part": {
          "enum": [
            "walls",
            "roof",
            "windows",
            "floor",
            "main-heating",
            "heating-controls",
            "hot-water",
            "lighting"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "stars": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "The register's efficiency rating of the part, 1 to 5 stars. A part with no rating is left out of the list, not given 0."
        }
      }
    },
    "partsFact": {
      "oneOf": [
        {
          "$ref": "#/$defs/missing"
        },
        {
          "type": "object",
          "required": [
            "value",
            "source"
          ],
          "additionalProperties": false,
          "properties": {
            "value": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/part"
              }
            },
            "source": {
              "$ref": "common.schema.json#/$defs/source"
            }
          }
        }
      ]
    },
    "improvement": {
      "type": "object",
      "required": [
        "sequence",
        "improvementCode",
        "indicativeCost",
        "typicalSaving"
      ],
      "additionalProperties": false,
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "description": "The certificate's own order."
        },
        "improvementCode": {
          "type": "integer",
          "minimum": 1,
          "description": "The register's improvement number. Words come from reference/energy-code-tables.json."
        },
        "indicativeCost": {
          "type": "string",
          "minLength": 1,
          "description": "The certificate's own range, as written (for example '£220 - £250'). Kept as text: the certificate states a range, not a figure."
        },
        "typicalSaving": {
          "$ref": "#/$defs/money"
        }
      }
    },
    "improvementsFact": {
      "oneOf": [
        {
          "$ref": "#/$defs/missing"
        },
        {
          "type": "object",
          "required": [
            "value",
            "source"
          ],
          "additionalProperties": false,
          "properties": {
            "value": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/improvement"
              }
            },
            "source": {
              "$ref": "common.schema.json#/$defs/source"
            }
          }
        }
      ]
    }
  }
}
