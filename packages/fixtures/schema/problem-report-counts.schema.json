{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vestagraph.invalid/schema/problem-report-counts.schema.json",
  "title": "Report a problem daily counts (data/problem-report-counts.json)",
  "description": "What the Report a problem feature may store: one count per day, source, reason and fact, with no postcode, no time of day, no free text and no user identity. Every key field holds a known value only: a topic key, a source key or a figure key from the lists below, or a source's own public identifier for a place. A count is the only one for its key: no two counts share the same date, shape fields (topic, record ID, council or figure, area code and level) and reason, so a per-report row cannot be stored (a fixture test checks this). Only a topic whose records are public facilities may be counted by record ID (recordIdTopics); every other topic is counted by topic and council only. Retention is 90 days.",
  "type": "object",
  "required": [
    "retentionDays",
    "counts"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "retentionDays": {
      "const": 90
    },
    "counts": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/factCount"
          },
          {
            "$ref": "#/$defs/areaCount"
          },
          {
            "$ref": "#/$defs/councilFigureCount"
          }
        ]
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "topicKey": {
      "enum": [
        "getting-around",
        "everyday-places",
        "places-of-worship",
        "schools",
        "planning-nearby",
        "flood",
        "crime",
        "sold-nearby",
        "broadband",
        "air-quality",
        "radon",
        "council-tax-by-band",
        "housing-affordability",
        "deprivation",
        "transport-connectivity",
        "green-space"
      ],
      "description": "A key of a counted topic in data/pilot-topics.json (a test checks that this list equals those keys, so they cannot drift). The server accepts only the topic it served on that page."
    },
    "councilCode": {
      "$ref": "council-area.schema.json#/$defs/councilCode"
    },
    "factCount": {
      "type": "object",
      "required": [
        "date",
        "source",
        "reason",
        "count",
        "topic",
        "factRecordId",
        "localAuthority",
        "recordKind"
      ],
      "additionalProperties": false,
      "properties": {
        "date": {
          "$ref": "#/$defs/date"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "reason": {
          "$ref": "#/$defs/reason"
        },
        "count": {
          "$ref": "#/$defs/count"
        },
        "topic": {
          "$ref": "#/$defs/recordIdTopics"
        },
        "factRecordId": {
          "$ref": "#/$defs/factRecordId"
        },
        "localAuthority": {
          "$ref": "#/$defs/localAuthority"
        },
        "recordKind": {
          "$ref": "#/$defs/recordKind"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "topic": {
                "const": "schools"
              }
            },
            "required": [
              "topic"
            ]
          },
          "then": {
            "properties": {
              "recordKind": {
                "enum": [
                  "school"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "topic": {
                "const": "everyday-places"
              }
            },
            "required": [
              "topic"
            ]
          },
          "then": {
            "properties": {
              "recordKind": {
                "enum": [
                  "gp-practice",
                  "hospital",
                  "pharmacy",
                  "public-place"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "topic": {
                "const": "getting-around"
              }
            },
            "required": [
              "topic"
            ]
          },
          "then": {
            "properties": {
              "recordKind": {
                "enum": [
                  "stop"
                ]
              }
            }
          }
        }
      ]
    },
    "areaCount": {
      "type": "object",
      "required": [
        "date",
        "source",
        "reason",
        "count",
        "topic",
        "localAuthority"
      ],
      "additionalProperties": false,
      "properties": {
        "date": {
          "$ref": "#/$defs/date"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "reason": {
          "$ref": "#/$defs/reason"
        },
        "count": {
          "$ref": "#/$defs/count"
        },
        "topic": {
          "$ref": "#/$defs/topicKey"
        },
        "localAuthority": {
          "$ref": "#/$defs/localAuthority"
        }
      },
      "description": "Used for every topic that may not carry a record ID (see recordIdTopics), for a record worked out from a postcode or that is a home-based service, and for gaps (the record's own gap line, Not known right now, Not yet covered). Counted by topic and council only."
    },
    "councilFigureCount": {
      "type": "object",
      "required": [
        "date",
        "source",
        "reason",
        "count",
        "figure",
        "areaCode",
        "areaLevel"
      ],
      "additionalProperties": false,
      "properties": {
        "date": {
          "$ref": "#/$defs/date"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "reason": {
          "$ref": "#/$defs/reason"
        },
        "count": {
          "$ref": "#/$defs/count"
        },
        "figure": {
          "$ref": "#/$defs/figure"
        },
        "areaCode": {
          "type": "string"
        },
        "areaLevel": {
          "enum": [
            "council",
            "neighbourhood"
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "areaLevel": {
              "const": "council"
            },
            "areaCode": {
              "$ref": "#/$defs/councilCode",
              "not": {
                "$ref": "#/$defs/lsoaCode"
              }
            }
          }
        },
        {
          "properties": {
            "areaLevel": {
              "const": "neighbourhood"
            },
            "areaCode": {
              "$ref": "#/$defs/lsoaCode"
            }
          }
        }
      ]
    },
    "date": {
      "$ref": "common.schema.json#/$defs/fullDate"
    },
    "source": {
      "enum": [
        "bank-of-england",
        "bgs-ukhsa-radon",
        "bus-open-data-service",
        "census-2021",
        "council-school-admissions",
        "defra-air-quality",
        "dft-transport-connectivity",
        "environment-agency",
        "get-information-about-schools",
        "hm-land-registry",
        "indices-of-deprivation",
        "mhclg-council-tax",
        "naptan",
        "natural-england",
        "ofcom",
        "ofsted",
        "ons-affordability",
        "ons-population",
        "ons-private-rents",
        "openstreetmap",
        "planning-data-platform",
        "police-uk",
        "uk-house-price-index"
      ],
      "description": "A key for a data source, from the sources the pilot's records name (postcode-area.json and council-area.json). Never free text. The server accepts only the source it served with that fact."
    },
    "figure": {
      "enum": [
        "affordability-series",
        "connectivity",
        "council-tax-band-d",
        "deprivation",
        "population",
        "price-series",
        "rent-series",
        "tenure"
      ],
      "description": "A City Explorer figure key, from the field names of council-area.json (council-tax-band-d stands for the bands field). Neighbourhoods publish connectivity, deprivation and tenure only. Never free text."
    },
    "reason": {
      "enum": [
        "wrong",
        "out-of-date",
        "missing-something"
      ]
    },
    "count": {
      "type": "integer",
      "minimum": 1
    },
    "factRecordId": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^[A-Z0-9]+(-[A-Z0-9]+)*$",
      "not": {
        "pattern": "[A-Z]{1,2}[0-9][A-Z0-9]?-?[0-9][A-Z]{2}"
      },
      "description": "The SOURCE's own public identifier for that place (a school URN such as 100001, a NaPTAN stop code such as 490000077E), never Vestagraph's record id (which holds the postcode), never a postcode or address. Upper-case letters, digits and single hyphens, at most 32 characters; an ID holding a postcode-shaped fragment (such as NB1-4XY) is refused. Checked against a school URN and a NaPTAN code. The server stores only a record ID it served on that page; the schema's pattern and length are a backstop, not the guard."
    },
    "lsoaCode": {
      "$ref": "council-area.schema.json#/$defs/lsoaCode"
    },
    "recordIdTopics": {
      "enum": [
        "getting-around",
        "everyday-places",
        "schools"
      ],
      "description": "The only topics that may carry a factRecordId, because their records are public facilities (a stop, a school, a GP surgery or hospital). Within them, a record that is worked out from a postcode (bus departures) or that is a home-based service (childcare) is counted by topic and council only. Every other topic is counted by topic and council only. A test checks that each is a key in pilot-topics.json. The record kind (recordKind) says which kinds of record each may use."
    },
    "localAuthority": {
      "$ref": "#/$defs/councilCode",
      "not": {
        "pattern": "^[EWSN]0[01]"
      },
      "description": "A council's code. A neighbourhood (LSOA, E01) or output area (E00) code is refused, because it is far smaller than a council."
    },
    "recordKind": {
      "enum": [
        "school",
        "gp-practice",
        "hospital",
        "pharmacy",
        "public-place",
        "stop"
      ],
      "description": "The kind of public record a fact count names. Never childcare (home-based). Which kinds each topic may use is set on factCount: schools, school; everyday-places, gp-practice, hospital, pharmacy or public-place; getting-around, stop."
    }
  }
}
