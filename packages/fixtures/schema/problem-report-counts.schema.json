{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vestagraph.invalid/schema/problem-report-counts.schema.json",
  "title": "Report a problem daily counts (data/problem-report-counts.json)",
  "description": "What the Report a problem feature may store: one count per day, source, reason and fact, with no postcode, no time of day, no free text and no user identity. A fact that points to one address or property is counted by topic and council only, never by record. Retention is 90 days.",
  "type": "object",
  "required": [
    "retentionDays",
    "counts"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "retentionDays": {
      "const": 90
    },
    "counts": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/factCount"
          },
          {
            "$ref": "#/$defs/areaCount"
          },
          {
            "$ref": "#/$defs/councilFigureCount"
          }
        ]
      }
    }
  },
  "$defs": {
    "topicKey": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "A key from data/pilot-topics.json."
    },
    "noRecordIdTopics": {
      "enum": [
        "sold-nearby",
        "planning-nearby"
      ],
      "description": "Topics whose records point to one address or property: never counted by record ID. Gaps are counted the same way. A test checks that each is a key in pilot-topics.json."
    },
    "councilCode": {
      "$ref": "council-area.schema.json#/$defs/councilCode"
    },
    "factCount": {
      "type": "object",
      "required": [
        "date",
        "source",
        "reason",
        "count",
        "topic",
        "factRecordId",
        "localAuthority"
      ],
      "additionalProperties": false,
      "properties": {
        "date": {
          "$ref": "#/$defs/date"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "reason": {
          "$ref": "#/$defs/reason"
        },
        "count": {
          "$ref": "#/$defs/count"
        },
        "topic": {
          "$ref": "#/$defs/topicKey"
        },
        "factRecordId": {
          "$ref": "#/$defs/factRecordId"
        },
        "localAuthority": {
          "$ref": "#/$defs/councilCode"
        }
      },
      "if": {
        "properties": {
          "topic": {
            "$ref": "#/$defs/noRecordIdTopics"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "factRecordId"
          ]
        }
      }
    },
    "areaCount": {
      "type": "object",
      "required": [
        "date",
        "source",
        "reason",
        "count",
        "topic",
        "localAuthority"
      ],
      "additionalProperties": false,
      "properties": {
        "date": {
          "$ref": "#/$defs/date"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "reason": {
          "$ref": "#/$defs/reason"
        },
        "count": {
          "$ref": "#/$defs/count"
        },
        "topic": {
          "$ref": "#/$defs/topicKey"
        },
        "localAuthority": {
          "$ref": "#/$defs/councilCode"
        }
      },
      "description": "Used for a fact whose record points to one address or property (topics sold-nearby and planning-nearby) and for gaps (Not known, Unavailable, Not yet covered). Counted by topic and council only."
    },
    "councilFigureCount": {
      "type": "object",
      "required": [
        "date",
        "source",
        "reason",
        "count",
        "figure",
        "areaCode",
        "areaLevel"
      ],
      "additionalProperties": false,
      "properties": {
        "date": {
          "$ref": "#/$defs/date"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "reason": {
          "$ref": "#/$defs/reason"
        },
        "count": {
          "$ref": "#/$defs/count"
        },
        "figure": {
          "$ref": "#/$defs/figure"
        },
        "areaCode": {
          "type": "string"
        },
        "areaLevel": {
          "enum": [
            "council",
            "neighbourhood"
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "areaLevel": {
              "const": "council"
            },
            "areaCode": {
              "$ref": "#/$defs/councilCode"
            }
          }
        },
        {
          "properties": {
            "areaLevel": {
              "const": "neighbourhood"
            },
            "areaCode": {
              "$ref": "#/$defs/lsoaCode"
            }
          }
        }
      ]
    },
    "date": {
      "$ref": "common.schema.json#/$defs/fullDate"
    },
    "source": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "A kebab-case key for the data source (for example environment-agency), never free text."
    },
    "figure": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "A kebab-case key for a City Explorer figure (for example council-tax-band-d), never free text."
    },
    "reason": {
      "enum": [
        "wrong",
        "out-of-date",
        "missing-something"
      ]
    },
    "count": {
      "type": "integer",
      "minimum": 1
    },
    "factRecordId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "description": "A record ID, never a postcode or address."
    },
    "lsoaCode": {
      "$ref": "council-area.schema.json#/$defs/lsoaCode"
    }
  }
}
