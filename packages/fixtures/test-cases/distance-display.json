        },
        {
          "n": 2,
          "description": "1,610 is not under 1,610, so miles."
        },
        {
          "n": 3,
          "description": "Stored metres in miles: 1605 / 1609.344 = 0.99730, to one decimal (0.99730 x 10 = 9.973, rounds to 10) = 1.0",
          "value": "1.0"
        },
        {
          "n": 4,
          "description": "Always one decimal: '1.0 miles'."
        }
      ],
      "expected": {
        "display": "1.0 miles"
      }
