    {
      "id": "under-10-m-1",
      "description": "1 m rounds to 0 m, so 'under 10 m'.",
      "rule": {
        "source": "FE-27 as amended (docs/product); a mile is exactly 1,609.344 m; halves away from zero",
        "url": "docs/superpowers/plans/2026-11-14-first-design-batch.md"
      },
      "inputs": {
        "metres": "1"
      },
      "steps": [
        {
          "n": 1,
          "description": "1 / 10 = 0.1, rounds to 0 (below half), so 0 x 10 = 0 m",
          "value": 0
        },
        {
          "n": 2,
          "description": "0 is under 10, so the text is 'under 10 m'."
        }
      ],
      "expected": {
        "display": "under 10 m"
      }
    },
